# Copie para .env (que esta no .gitignore); a API le o .env sozinha ao subir.
# Credenciais AWS: prefira o perfil local (aws configure / aws login) ou IAM Role. Se precisar de chaves aqui,
# use um principal com leitura da gold, Athena/Glue e escrita no prefixo dedicado das exportacoes do cache.
DB_URL=jdbc:postgresql://localhost:5433/fireatlas
DB_USER=fireatlas
DB_PASSWORD=fireatlas
CORS_ORIGINS=http://localhost:3000
# Bucket do data lake (nome ou s3://nome): prata, logs Delta e cache mundial da grade de 2026.
DATALAKE_BUCKET=<nome-do-bucket-do-data-lake>
AWS_REGION=us-east-2
# Athena: projeta a carga anual via UNLOAD e consulta diretamente os demais anos/produtos.
# ATHENA_DATABASE=fireatlas_gold
# ATHENA_WORKGROUP=fireatlas-api
# ATHENA_RESULT_REUSE_MINUTES=1440
# ATHENA_TIMEOUT_MS=30000
# Cache compartilhado de 2026: intervalo minimo entre revalidacoes dos manifestos Delta.
# BOOTSTRAP_REFRESH_HOURS=6
# BOOTSTRAP_IMPORT_WORKERS=2
# BOOTSTRAP_EXPORT_CONCURRENCY=2
# BOOTSTRAP_EXPORT_TIMEOUT_MS=300000
# Destino S3 exclusivo de UNLOAD; vazio deriva do OutputLocation configurado no workgroup.
# BOOTSTRAP_EXPORT_PREFIX=s3://<bucket>/athena-results/bootstrap/2026/
