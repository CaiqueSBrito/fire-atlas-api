# Copie para .env (que esta no .gitignore). NUNCA coloque chaves AWS aqui:
# as credenciais vem do perfil local (aws configure) ou de IAM Role.
DB_URL=jdbc:postgresql://localhost:5433/fireatlas
DB_USER=fireatlas
DB_PASSWORD=fireatlas
CORS_ORIGINS=http://localhost:3000
DATALAKE_BUCKET=<nome-do-bucket-do-data-lake>
AWS_REGION=us-east-2
COOKIE_SAME_SITE=Lax
COOKIE_SECURE=false
APPROVED_PRODUCTS=MODIS_C6.1,VIIRS_S-NPP,VIIRS_NOAA-20,VIIRS_NOAA-21
H3_COLUMN=h3
# bronze/raw/ = CSV bruto (sem H3); use gold/ quando o Parquet com H3 estiver na camada ouro
LAKE_PREFIX=bronze/raw/
# Resolucao do H3 guardado em cada foco (a mais fina que a fonte entrega): 8 no dado bruto, 6 no ouro
H3_BASE_RESOLUTION=8
# Resolucao do H3 guardado em cada foco (a mais fina que a fonte entrega): 8 no dado bruto, 6 no ouro
H3_BASE_RESOLUTION=8
