# Copie para .env (que esta no .gitignore); a API e o scripts/atualizar.sh leem o .env sozinhos.
# Credenciais AWS: prefira o perfil local (aws configure / aws login) ou IAM Role. Se precisar de chaves aqui,
# use um usuario so leitura do prefixo gold/ (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY e, se temporarias, AWS_SESSION_TOKEN).
DB_URL=jdbc:postgresql://localhost:5433/fireatlas
DB_USER=fireatlas
DB_PASSWORD=fireatlas
CORS_ORIGINS=http://localhost:3000
# Bucket do data lake (nome ou s3://nome): scripts/atualizar.sh baixa a gold dele para o PostgreSQL.
DATALAKE_BUCKET=<nome-do-bucket-do-data-lake>
AWS_REGION=us-east-2
