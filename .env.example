# Copie para .env (que esta no .gitignore). NUNCA coloque chaves AWS aqui:
# as credenciais vem do perfil local (aws configure) ou de IAM Role.
DB_URL=jdbc:postgresql://localhost:5433/fireatlas
DB_USER=fireatlas
DB_PASSWORD=fireatlas
CORS_ORIGINS=http://localhost:3000
DATALAKE_BUCKET=<nome-do-bucket-do-data-lake>
AWS_REGION=us-east-2
COOKIE_SAME_SITE=Lax
COOKIE_SECURE=false
# Camada ouro (tabela Delta, uma linha por celula H3, dia e sensor)
GOLD_TABLE=gold/map_grid/
# Maior resolucao H3 da fonte: a gold entrega de 0 a 6
H3_BASE_RESOLUTION=6
